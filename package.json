{
  "name": "reference-shelf",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first, full-window reference canvas with multiple non-destructive image crops for Obsidian Desktop.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:live": "npm run build && node scripts/live-test.mjs",
    "check": "npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
